# ── Frontend (Vite) configuration ───────────────────────────────────────
# Leave VITE_API_URL BLANK for local development. The app calls relative
# paths like /api/pain-analysis and Vite proxies them to the backend
# (see vite.config.js), so there are no CORS or mixed-content problems.
#
# Only set VITE_API_URL in production IF the backend is on a DIFFERENT
# origin, e.g.  VITE_API_URL=https://api.physiochandra.com
# If you reverse-proxy /api to Node via Nginx on the same domain, leave blank.
VITE_API_URL=

# ── Talking guide: Chandra's cloned voice (npm run guide:audio) ─────────
# Used only by scripts/make-guide-audio.mjs on this computer, never by the
# website. From elevenlabs.io: Profile → API keys, and Voices → your voice → ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
