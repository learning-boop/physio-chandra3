# ── Backend (Pain AI server) configuration ──────────────────────────────
# Copy this file to ".env" in the SAME folder and fill in real values.
# NEVER commit the real .env — it holds your secret key.

# Your Anthropic API key. Must be ONE value that starts with "sk-ant-".
# Get or rotate a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the server listens on (the frontend/dev proxy expects 4000).
PORT=4000
